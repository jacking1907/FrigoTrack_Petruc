{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frigotrack.example/schemas/readings_request.json",
  "title": "Richiesta di consultazione misure",
  "description": "Tutti i filtri sono opzionali. Vengono restituite le ultime 'limit' misure (ordinate per timestamp crescente) che rispettano i filtri.",
  "type": "object",
  "properties": {
    "sensor_id": { "type": "string", "pattern": "^[A-Z]+-[A-Z]{2}-[0-9]{3}$" },
    "from": { "type": "string", "format": "date-time", "description": "estremo inferiore incluso" },
    "to": { "type": "string", "format": "date-time", "description": "estremo superiore incluso" },
    "limit": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 100 }
  },
  "additionalProperties": false
}
