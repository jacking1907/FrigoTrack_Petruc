{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frigotrack.example/schemas/envelope.json",
  "title": "Busta cifrata",
  "description": "Unico formato visibile in rete dopo l'handshake. Cifratura AES-256-GCM: ciphertext e tag sono separati, il nonce a 96 bit e' casuale per ogni messaggio. Tutti i campi binari sono in Base64.",
  "type": "object",
  "required": ["session_id", "nonce", "ciphertext", "tag"],
  "properties": {
    "session_id": { "type": "string", "pattern": "^[0-9a-f]{8,64}$" },
    "nonce": { "type": "string", "pattern": "^[A-Za-z0-9+/]{16}$", "description": "12 byte in Base64" },
    "ciphertext": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "minLength": 4, "maxLength": 87400 },
    "tag": { "type": "string", "pattern": "^[A-Za-z0-9+/]{22}==$", "description": "16 byte in Base64" }
  },
  "additionalProperties": false
}
