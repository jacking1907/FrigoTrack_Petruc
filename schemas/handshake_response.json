{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frigotrack.example/schemas/handshake_response.json",
  "title": "Handshake - risposta del server",
  "description": "Il server risponde con l'identificativo di sessione e la propria chiave pubblica B = g^b mod p.",
  "type": "object",
  "required": ["session_id", "B"],
  "properties": {
    "session_id": { "type": "string", "pattern": "^[0-9a-f]{8,64}$" },
    "B": { "type": "string", "pattern": "^[0-9a-fA-F]{1,1024}$", "description": "chiave pubblica del server (hex)" }
  },
  "additionalProperties": false
}
